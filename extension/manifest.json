{
  "manifest_version": 3,
  "name": "AgentEyes",
  "version": "0.10.0",
  "description": "Sends the current page (or your selection) to a local agent bridge — on demand, or continuously with auto-watch.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AgentEyes",
    "default_popup": "popup.html"
  },
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Send current page or selection to the local agent bridge"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Highlight and click a specific element to send just that"
    },
    "toggle-watch": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Start/stop auto-watch on this tab"
    },
    "scan-surface": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Scan the page's interactive surface"
    }
  }
}
