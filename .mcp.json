{
  "mcpServers": {
    "agent-eyes": {
      "command": "bun",
      "args": [
        "run",
        "bridge/src/index.ts"
      ],
      "env": {
        "AGENT_EYES_MODE": "read",
        "AGENT_EYES_STALE_AFTER": "30"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--memoryDebugging",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
